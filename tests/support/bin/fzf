#!/bin/sh
# Fake fzf: records its input and (appending) its arguments, then prints the line chosen in
# $PQ_FAKE_DIR/fzf-pick (1-based, default 1) or exits 130 when it says
# "cancel", as fzf does on Esc.
set -u
dir=${PQ_FAKE_DIR:?PQ_FAKE_DIR is not set}

cat >"$dir/fzf-input"
# One line per invocation, appended, so no earlier call's arguments are lost.
record=""
for arg in "$@"; do record="$record$arg	"; done
printf '%s\n' "$record" >>"$dir/fzf-args"

# fzf-reply, when present, is printed as-is, to simulate unexpected output.
if [ -f "$dir/fzf-reply" ]; then
    cat "$dir/fzf-reply"
    exit 0
fi
# fzf-picks, when present, holds one pick per line, used one per invocation.
if [ -s "$dir/fzf-picks" ]; then
    pick=$(sed -n 1p "$dir/fzf-picks")
    sed 1d "$dir/fzf-picks" >"$dir/fzf-picks.rest"
    cat "$dir/fzf-picks.rest" >"$dir/fzf-picks"
else
    pick=$(cat "$dir/fzf-pick" 2>/dev/null || echo 1)
fi
if [ "$pick" = cancel ]; then
    exit 130
fi
sed -n "${pick}p" "$dir/fzf-input"
