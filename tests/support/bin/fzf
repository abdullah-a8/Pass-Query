#!/bin/sh
# Fake fzf: records its input and arguments, then prints the line chosen in
# $PQ_FAKE_DIR/fzf-pick (1-based, default 1) or exits 130 when it says
# "cancel", as fzf does on Esc.
set -u
dir=${PQ_FAKE_DIR:?PQ_FAKE_DIR is not set}

cat >"$dir/fzf-input"
for arg in "$@"; do printf '%s\t' "$arg"; done >"$dir/fzf-args"

pick=$(cat "$dir/fzf-pick" 2>/dev/null || echo 1)
if [ "$pick" = cancel ]; then
    exit 130
fi
sed -n "${pick}p" "$dir/fzf-input"
