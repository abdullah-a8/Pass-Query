#!/bin/sh
# Fake pass-cli for pq's integration tests.
#
# Replays the scenario that tests/support/mod.rs writes into $PQ_FAKE_DIR,
# using the JSON shapes of pass-cli 2.5.1, and appends every invocation to
# $PQ_FAKE_DIR/calls (one call per line, arguments separated by tabs).
# Anything pq is not expected to send is rejected, so a change in how pq
# calls pass-cli fails the tests instead of passing silently.
set -u
dir=${PQ_FAKE_DIR:?PQ_FAKE_DIR is not set}

# Build the whole record first and append it with one printf, so records of
# concurrent calls (pq lists up to 10 vaults at once) cannot interleave.
record=""
for arg in "$@"; do record="$record$arg	"; done
printf '%s\n' "$record" >>"$dir/calls"

command="${1:-}-${2:-}"

# What a process pq starts can see of pq: the core file size limit it
# inherited and, on Linux, whether pq's environment is readable through /proc
# (it is not once pq has made itself non-dumpable).
probe="core=$(ulimit -c)"
if [ -e "/proc/$PPID/environ" ]; then
    # Only a refusal counts as protection; any other failure is reported as such.
    if denied=$(cat "/proc/$PPID/environ" 2>&1 >/dev/null); then
        probe="$probe proc=readable"
    else
        case "$denied" in
        *"Permission denied"*) probe="$probe proc=protected" ;;
        *) probe="$probe proc=unreadable" ;;
        esac
    fi
fi
printf '%s\n' "$probe" >"$dir/probe"

# The log levels pass-cli was started with. With debug logging on, real
# pass-cli (through its HTTP library) logs whole requests, bearer token
# included, to stderr; the fake does the same so tests can prove pq never
# lets that through.
printf '%s %s\n' "${MUON_LOG_LEVEL:-unset}" "${PASS_LOG_LEVEL:-unset}" >>"$dir/log-levels"
if [ "${MUON_LOG_LEVEL:-off}" != off ]; then
    echo "2026-10-24T12:00:00Z DEBUG muon: sending request: Authorization: Bearer tok-FAKE-SESSION-TOKEN" >&2
fi

# Injected failure: fail/<command> holds the stderr text, fail/<command>.code
# the exit status (default 1). fail/item-list.<share-id> fails one vault.
if [ -f "$dir/fail/$command" ]; then
    cat "$dir/fail/$command" >&2
    exit "$(cat "$dir/fail/$command.code" 2>/dev/null || echo 1)"
fi

unsupported() {
    echo "fake pass-cli: unsupported invocation: $*" >&2
    exit 2
}

case "$command" in
--version-)
    # pass-cli prints "<name> <version> (<git hash>)". delay/version slows it.
    if [ -f "$dir/delay/version" ]; then
        sleep "$(cat "$dir/delay/version")"
    fi
    printf 'Proton Pass CLI %s (0a1b2c3)\n' "$(cat "$dir/version" 2>/dev/null || echo 2.5.1)"
    ;;
vault-list)
    shift 2
    [ "$*" = "--output json" ] || unsupported "vault list $*"
    cat "$dir/vaults.json"
    ;;
item-list)
    shift 2
    share="" filter="" output=""
    while [ $# -gt 0 ]; do
        case "$1" in
        --share-id=*) share=${1#--share-id=} ;;
        --filter-type) [ $# -ge 2 ] || unsupported "item list $*"; filter=$2; shift ;;
        --output) [ $# -ge 2 ] || unsupported "item list $*"; output=$2; shift ;;
        *) unsupported "item list $*" ;;
        esac
        shift
    done
    [ "$output" = json ] || unsupported "item list without --output json"
    [ -n "$share" ] || unsupported "item list without --share-id"
    [ -z "$filter" ] || [ "$filter" = login ] || unsupported "item list --filter-type $filter"
    # delay/item-list.<share-id> holds seconds to wait first (a slow vault).
    if [ -f "$dir/delay/item-list.$share" ]; then
        sleep "$(cat "$dir/delay/item-list.$share")"
    fi
    if [ -f "$dir/fail/item-list.$share" ]; then
        cat "$dir/fail/item-list.$share" >&2
        exit 1
    fi
    if [ -n "$filter" ]; then
        cat "$dir/items/$share.$filter.json"
    else
        cat "$dir/items/$share.json"
    fi
    ;;
item-view)
    shift 2
    share="" item="" field="" output=""
    while [ $# -gt 0 ]; do
        case "$1" in
        --share-id=*) share=${1#--share-id=} ;;
        --item-id=*) item=${1#--item-id=} ;;
        --field) [ $# -ge 2 ] || unsupported "item view $*"; field=$2; shift ;;
        --output) [ $# -ge 2 ] || unsupported "item view $*"; output=$2; shift ;;
        *) unsupported "item view $*" ;;
        esac
        shift
    done
    [ -n "$share" ] || unsupported "item view without --share-id"
    [ -n "$item" ] || unsupported "item view without --item-id"
    # delay/item-view.<item-id> slows, fail/item-view.<item-id> fails one item.
    if [ -f "$dir/delay/item-view.$item" ]; then
        sleep "$(cat "$dir/delay/item-view.$item")"
    fi
    if [ -f "$dir/fail/item-view.$item" ]; then
        cat "$dir/fail/item-view.$item" >&2
        exit 1
    fi
    # Items live under their vault's share: a wrong share finds nothing, as
    # with the real pass-cli.
    if [ ! -f "$dir/views/$share/$item.json" ]; then
        printf 'Error: Error retrieving item\n\nCaused by:\n    Could not perform operation. Reason: NotExists\n' >&2
        exit 1
    fi
    if [ -n "$field" ]; then
        [ -z "$output" ] || unsupported "item view --field with --output"
        # pass-cli omits empty fields and fails on a missing one.
        if [ -f "$dir/fields/$share/$item/$field" ]; then
            cat "$dir/fields/$share/$item/$field"
        else
            echo "Error: Field does not exist: $field" >&2
            exit 1
        fi
    elif [ "$output" = json ] && [ -f "$dir/replace/item-view.$item" ]; then
        # replace/item-view.<item-id>: answer with this JSON instead.
        cat "$dir/replace/item-view.$item"
    elif [ "$output" = json ]; then
        cat "$dir/views/$share/$item.json"
    else
        unsupported "item view without --field or --output json"
    fi
    ;;
*)
    unsupported "$@"
    ;;
esac
